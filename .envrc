# shellcheck shell=bash
if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi
use flake

# Keep PlatformIO's toolchains/cache (~1-2 GB) on persisted disk: this NixOS
# root is a 4 GB tmpfs, so the default ~/.platformio lives in RAM and is wiped
# on reboot. expand_path resolves relative to this .envrc, not the cwd.
export PLATFORMIO_CORE_DIR="$(expand_path ./.platformio)"
